# Copy to .env.vision and edit. start-vision.sh also regenerates per-node
# env files from these knobs when run from the head.

# --- Hugging Face / local layout ---
HF_CACHE=${HOME}/.cache/huggingface
# Absolute path to this repo's plugin/ directory on THIS machine
PLUGIN_DIR=${HOME}/DeepSeek-V4-Vision-2x-DGX-Sparks/plugin
# Host directory that contains deepencoder_v2_tower.safetensors
TOWER_DIR=${HOME}/dsv4-vision-assets/tower
# Host directory that contains the adapter .pt (merged-004800-5af0c5.pt or latest.pt)
CKPT_DIR=${HOME}/dsv4-vision-assets/adapter

# Container paths (match docker-compose mounts). Prefer the published name.
DSV4_VISION_ADAPTER=/ckpt/merged-004800-5af0c5.pt
# Tower filename is fixed in compose as /tower/deepencoder_v2_tower.safetensors

# --- Image ---
DSPARK_VLLM_IMAGE=dsv4-vision-vllm:0.1.1
SERVED_MODEL_NAME=deepseek-v4-flash-0731-vision
VLLM_HOST=0.0.0.0
VLLM_PORT=8899
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.80
MM_IMAGE_LIMIT=8

# --- Two-node fabric (REQUIRED) ---
# Head fabric IP (RoCE data plane — not your management VPN IP)
MASTER_ADDR=192.168.100.2
MASTER_PORT=25100
# Per-node: set when generating env (start-vision.sh sets these)
# VLLM_HOST_IP=192.168.100.2   # head
# VLLM_HOST_IP=192.168.100.1   # worker
# NODE_RANK=0|1
# HEADLESS=   |1

# Worker SSH target as seen FROM the head (fabric IP or ssh Host alias)
WORKER_HOST=192.168.100.1
# Absolute path of this repo on the WORKER (may differ by username)
WORKER_DIR=${HOME}/DeepSeek-V4-Vision-2x-DGX-Sparks
HEAD_FABRIC_IP=192.168.100.2
WORKER_FABRIC_IP=192.168.100.1

# When worker username/home differs from head (common), set these explicitly:
# WORKER_HF_CACHE=/home/other/.cache/huggingface
# WORKER_PLUGIN_DIR=/home/other/DeepSeek-V4-Vision-2x-DGX-Sparks/plugin
# WORKER_TOWER_DIR=/home/other/dsv4-vision-assets/tower
# WORKER_CKPT_DIR=/home/other/dsv4-vision-assets/adapter

# --- NCCL / RoCE (match `ibdev2netdev` on your Sparks) ---
NCCL_IB_HCA=rocep1s0f1
NCCL_SOCKET_IFNAME=enp1s0f1np1
NCCL_IB_GID_INDEX=3

# Optional chat-template flag (usually empty; train_layout.jinja available)
CHAT_TEMPLATE_FLAG=
